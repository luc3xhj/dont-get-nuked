# Copy to .env.local (git-ignored) and fill in. The agent service reads .env.local at start.

# Treg free web search (sign in at https://treg.to/app and create a token).
# The agent only calls endpoints Treg's catalog lists as free ($0), with a $0 cost cap.
TREG_TOKEN=

# Optional: absolute path to the Codex CLI. Desktop app and PATH installs are detected.
# Uses your existing `codex login` (ChatGPT) session; no OpenAI API key is needed.
# CODEX_BIN=

# Optional analyst tuning.
# Defaults to GPT-6.1 Sol. The worker always selects its model explicitly; no Astra fallback.
ANALYST_MODEL=gpt-6.1-sol
# ANALYST_MAX_PER_HOUR=20
