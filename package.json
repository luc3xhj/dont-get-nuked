{
  "name": "dont-get-nuked",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test agent/*.test.ts",
    "research:check": "node --env-file-if-exists=.env.local --import tsx scripts/check-research.ts",
    "agent": "node --env-file-if-exists=.env.local --import tsx agent/main.ts",
    "agent:install": "node scripts/agent-service.mjs install",
    "agent:start": "node scripts/agent-service.mjs start",
    "agent:stop": "node scripts/agent-service.mjs stop",
    "agent:status": "node scripts/agent-service.mjs status",
    "agent:uninstall": "node scripts/agent-service.mjs uninstall"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.1",
    "next": "^15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
